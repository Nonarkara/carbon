{
  "name": "forest-carbon-thailand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node dev-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:all": "node scripts/browser-suite.mjs",
    "test:figures": "node scripts/shoot-figures.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "deploy": "node scripts/lib/assert-clean-tree.mjs && npm run build && npm test && npm run test:spatial -- --no-build && npm run test:deep && wrangler pages deploy public --project-name forest-carbon-thailand",
    "test:client": "node scripts/client-demo-test.mjs",
    "test:manual": "node scripts/manual-walkthrough.mjs",
    "test:design": "node scripts/design-review.mjs",
    "test:spatial": "node scripts/spatial-suite.mjs",
    "test:deep": "node scripts/spatial-deep-probe.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@turf/area": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/kinks": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
