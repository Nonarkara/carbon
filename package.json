{
  "name": "forest-carbon-thailand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node dev-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "deploy": "npm run build && npm test && wrangler pages deploy public --project-name forest-carbon-thailand",
