    "test:design": "node scripts/design-review.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@turf/area": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/kinks": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "wrangler": "^4.143.0"
  }
}
